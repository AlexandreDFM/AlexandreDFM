###############################################################################
### Site (read at runtime by the server, see util/config.ts)

SITE_URL="http://localhost:3000"
# "true" on staging: every page is served with X-Robots-Tag: noindex
SITE_NOINDEX="false"

###############################################################################
### Directus (server side only, never exposed to the browser)

# Inside docker compose: http://backend:8055 ; outside: http://localhost:8055
DIRECTUS_URL="http://backend:8055"
# Static token of the read-only "website" user (read published items + directus_files only)
DIRECTUS_WEBSITE_TOKEN="change-me"

###############################################################################
### SEO (optional)

# Google Search Console verification code; leave empty to omit the meta tag
GOOGLE_SITE_VERIFICATION=""
